<idea-plugin>
    <id>com.example.intellij-mcp-server</id>
    <name>IntelliJ MCP Server</name>
    <vendor>Example</vendor>
    <description>Exposes the open project to Claude Code over MCP: one server per trusted project on 127.0.0.1 (ports 6789-6800), plus a bundled stdio proxy that routes Claude Code to the right IDE window</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.example.mcpserver.McpPluginService"/>
        <postStartupActivity implementation="com.example.mcpserver.McpStartupActivity"/>
        <notificationGroup id="IntelliJ MCP Server (WolfTasks)"
                           displayType="BALLOON"
                           isLogByDefault="false"/>
    </extensions>
</idea-plugin>
